// SieReach Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BusinessPortfolio {
  id          String   @id @default(cuid())
  name        String   @unique
  industry    String?  @default("General")
  icon        String?  @default("🏢")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FacebookPage {
  id           String   @id @default(cuid())
  pageId       String   @unique
  name         String
  category     String   @default("Business")
  businessName String   @default("SieLab Retail Group")
  avatarUrl    String?
  accessToken  String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads      LeadConversation[]
  campaigns  FollowUpCampaign[]
  logs       BlastLog[]
  cdcTargets CdcPostTarget[]
}

model LeadConversation {
  id                    String    @id @default(cuid())
  pageId                String
  page                  FacebookPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  psid                  String
  customerName          String
  customerAvatar        String?
  adSource              String?
  lastCustomerMessage   String
  lastCustomerMessageAt DateTime
  lastAgentMessage      String
  lastAgentMessageAt    DateTime
  status                String    @default("AWAITING_CUSTOMER") // AWAITING_CUSTOMER, FOLLOWED_UP, REPLIED, CONVERTED, CLOSED
  followUpCount         Int       @default(0)
  lastFollowedUpAt      DateTime?
  firstFollowedUpAt     DateTime?
  secondFollowedUpAt    DateTime?
  repliedAt             DateTime?
  repliedAfterStep      Int?      // 1 if customer replied after Step 1, 2 if after Step 2
  notes                 String?
  isConverted           Boolean   @default(false)
  orderValue            Float?    // Actual or estimated converted purchase revenue ($)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  logs BlastLog[]

  @@unique([pageId, psid])
}

model FollowUpCampaign {
  id                     String    @id @default(cuid())
  name                   String
  businessName           String    @default("SieLab Retail Group") // dedicated business portfolio
  pageId                 String?   // null if applies to all pages in this business portfolio
  page                   FacebookPage? @relation(fields: [pageId], references: [pageId], onDelete: SetNull)
  inactiveHoursThreshold Float     @default(24.0) // detect customer not responding after this many hours
  messageTemplate        String
  imageUrl               String?
  imageUrls              String?   // JSON array of multiple uploaded poster URLs
  enableImageSpin        Boolean   @default(false) // Randomly rotate across uploaded posters per customer
  audioUrl               String?   // Voice note / audio message URL
  audioUrls              String?   // JSON array of voice notes for audio rotation
  enableAudioSpin        Boolean   @default(false) // Randomly rotate across uploaded/recorded voice notes
  mediaType              String    @default("image") // "none", "image", "audio", "both"
  messageTag             String?   @default("HUMAN_AGENT")
  autoBlast              Boolean   @default(false)
  excludePast24h         Boolean   @default(true) // Exclude leads >24h requiring HUMAN_AGENT tag by default
  dripMinSeconds         Float     @default(3.0)  // Minimum random interval delay between messages (min 3s)
  dripMaxSeconds         Float     @default(5.0)  // Maximum random interval delay between messages
  maxFollowUps           Int       @default(1)    // Default to 1 follow-up; max 2 allowed
  cooldownHours          Float     @default(3.0)  // Minimum waiting time (hours) before Step 2 (e.g. 3h)
  step2CampaignId        String?                  // Optional: ID of different blast rule/campaign to use for Step 2
  step2MessageTemplate   String?                  // Optional: Custom message template for Step 2
  step2ImageUrl          String?                  // Optional: Custom image for Step 2
  step2AudioUrl          String?                  // Optional: Custom voice note for Step 2
  isActive               Boolean   @default(true)
  lastRunAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  logs BlastLog[]
}

model BlastLog {
  id            String    @id @default(cuid())
  campaignId    String?
  campaign      FollowUpCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  pageId        String
  page          FacebookPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  leadId        String?
  lead          LeadConversation? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  recipientPsid String
  recipientName String
  messageSent   String
  imageUrl      String?
  audioUrl      String?   // Optional voice note / audio attachment sent
  status        String    // DELIVERED, FAILED, POLICY_VIOLATION_SKIPPED
  step          Int       @default(1) // Step 1 or Step 2
  respondedAt   DateTime?
  errorMessage  String?
  sentAt        DateTime  @default(now())
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ==========================================
// CDC (Channel Distribution Center) Models
// ==========================================

model CdcPostTemplate {
  id           String   @id @default(cuid())
  businessName String   @default("SieLab Retail Group")
  title        String
  category     String   @default("Promotion") // Promotion, Announcement, Product, Engagement, Tips, Seasonal
  content      String   // Formatted text with placeholders: {{page_name}}, {{business_name}}, Spintax
  mediaType    String   @default("none") // "none", "image", "multi_image", "video"
  mediaUrls    String?  // JSON array of image/video URLs
  tags         String?  // JSON array or comma-separated tags
  isPinned     Boolean  @default(false)

  // High-Growth & Lead Conversion
  enableFirstComment   Boolean  @default(false)
  firstComment         String?
  callToActionType     String?  @default("NONE") // NONE, MESSAGE_PAGE, WHATSAPP, LEARN_MORE, SHOP_NOW
  callToActionTitle    String?  @default("Direct Messenger Inquiry")
  callToActionUrl      String?
  enableCommentToDm    Boolean  @default(false)
  commentToDmKeyword   String?  @default("ALL") // "ALL" or comma-separated "pm, price, info"
  commentToDmReply     String?  // Public comment reply
  commentToDmMiniBlast String?  // Private Messenger DM

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CdcPost {
  id           String          @id @default(cuid())
  businessName String          @default("SieLab Retail Group")
  title        String?
  content      String
  mediaType    String          @default("none") // "none", "image", "multi_image", "video"
  mediaUrls    String?         // JSON array of asset URLs
  status       String          @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHING, PUBLISHED, PARTIALLY_FAILED, FAILED
  scheduledAt  DateTime?
  publishedAt  DateTime?

  // High-Growth & Lead Conversion
  enableFirstComment   Boolean  @default(false)
  firstComment         String?
  callToActionType     String?  @default("NONE") // NONE, MESSAGE_PAGE, WHATSAPP, LEARN_MORE, SHOP_NOW
  callToActionTitle    String?  @default("Direct Messenger Inquiry")
  callToActionUrl      String?
  enableCommentToDm    Boolean  @default(false)
  commentToDmKeyword   String?  @default("ALL")
  commentToDmReply     String?
  commentToDmMiniBlast String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  targets      CdcPostTarget[]
}

model CdcPostTarget {
  id             String       @id @default(cuid())
  postId         String
  post           CdcPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageId         String
  page           FacebookPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, PUBLISHED, FAILED
  metaPostId     String?
  firstCommentId String?      // Meta Graph API ID for the auto first comment
  errorMessage   String?
  publishedAt    DateTime?
  customText     String?
  scheduledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([postId, pageId])
}

// ==========================================
// Advanced Ads Analytics & Creative Intelligence
// ==========================================

model AdCreativeInsight {
  id                    String   @id @default(cuid())
  adSource              String   @unique
  pageId                String?
  pageName              String?
  businessName          String   @default("SieLab Retail Group")
  mediaType             String   @default("photo") // "photo", "video", "carousel", "text"
  visualStyle           String   @default("Studio Product") // "UGC / Real Life", "Studio Product", "Lifestyle In-Use", "Before-After", "Infographic / Diagram", "Cinematic Reel", "Meme / Trend"
  mediaUrl              String?
  videoDurationSeconds  Int      @default(0)
  aspectRatio           String   @default("1:1") // "9:16", "1:1", "4:5", "16:9"
  visualHook            String?
  hookHeadline          String?
  copywritingFramework  String   @default("Direct Offer") // "Problem-Agitate-Solve (PAS)", "Direct Offer / Discount", "Social Proof / Testimonial", "FOMO / Scarcity", "Educational / How-to", "Storytelling"
  callToAction          String   @default("Send Message")
  emotionalTone         String   @default("Direct Value") // "Urgency & FOMO", "Trust & Authority", "Curiosity & Wonder", "Delight & Luxury", "Direct Value"
  contentLengthCategory String   @default("Medium (50-150 words)") // "Short (<50 words)", "Medium (50-150 words)", "Long (>150 words)"
  uniqueSellingPoint    String?
  campaignObjective     String   @default("MESSAGES") // "MESSAGES", "SALES", "CONVERSIONS", "LEADS", "ENGAGEMENT"
  campaignDesign        String   @default("Cold Audience Broad") // "Cold Audience Broad", "Retargeting Cart Abandoners", "Lookalike 1% Buyers", "Flash Sale Blast"
  targetAudience        String   @default("General Shoppers")
  placement             String   @default("All Meta Placements") // "IG Reels + FB Feed", "FB Feed Only", "Instagram Explore + Stories"
  offerType             String   @default("Percentage Discount") // "Percentage Discount", "BOGO (Buy 1 Get 1)", "Free Gift", "Free COD Shipping", "Bundle Saving"
  adSpendEstimated      Float    @default(50.0)
  orderConversionValue  Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
