# ==============================================================================
# SieReach Meta - Production Environment Configuration
# ==============================================================================

# Database Connection (Supabase PostgreSQL, Neon, or local SQLite)
# For Supabase with Transaction Connection Pooling (Recommended on Vercel):
# DATABASE_URL: Supabase Project Settings -> Database -> Connection String -> Mode: Transaction (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Project Settings -> Database -> Connection String -> Mode: Session / Direct (port 5432)
# Used by Prisma for schema sync & migrations without pgbouncer connection locks:
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# For local SQLite development (default):
# DATABASE_URL="file:./dev.db"

# Admin Access Gate PIN & JWT Session Secret
ADMIN_PIN="sielab2026"
SESSION_SECRET="sielab_reach_super_secret_session_key_2026_change_in_production"

# Background Scheduled Cron Secret & Host URL
CRON_SECRET="sielab_cron_secret_key_production"
PUBLIC_URL="https://your-domain.railway.app"

# Meta Graph API Credentials (Optional: override connected pages)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="sielab_meta_webhook_verify_token"

# AI Advisor & Intelligence (Optional: Google Gemini API)
GEMINI_API_KEY=""

# Server Configuration
PORT=3000
NODE_ENV="production"
