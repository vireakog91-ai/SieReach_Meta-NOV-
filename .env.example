# =============================================================================
# SieLab Reach — Production Environment Variables (Vercel & Cloud)
# You can copy and paste this entire block directly into Vercel's Environment Variables tab!
# =============================================================================

# 1. Neon Serverless Postgres Database Connection String
# Replace with your Neon connection string (enable "Pooled connection" in Neon dashboard)
DATABASE_URL="postgresql://username:password@ep-something-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. JWT Session Secret (Random 32+ characters for securing session cookies)
AUTH_SECRET="sielab_reach_sec_98f4e21a87b64019a3c20d7e45b128f7"

# 3. Optional: Public URL (your live Vercel domain or custom domain)
# NEXT_PUBLIC_APP_URL="https://sielab-reach.vercel.app"
