{
  "name": "sielab-reach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-prisma.js && next dev -H 0.0.0.0 -p 3001",
    "build": "node scripts/sync-prisma.js && prisma generate && node -e \"const url = process.env.DATABASE_URL || process.env.POSTGRES_PRISMA_URL || process.env.POSTGRES_URL || process.env.STORAGE_URL; if (url && !url.startsWith('file:')) { require('child_process').execSync('npx prisma db push --accept-data-loss', { stdio: 'inherit' }); }\" && next build",
    "postinstall": "node scripts/sync-prisma.js && prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/sync-prisma.js && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
